{
  "name": "@neuroui/tailwind",
  "version": "0.5.0",
  "type": "module",
  "description": "Tailwind CSS plugin for NeuroUI sensory-adaptive variants",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
